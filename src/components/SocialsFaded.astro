---
import { socials, phoneForTel, phoneFormatted, email, whatsappLink } from "@data/client.json";

interface Props {
  iconColor?: string;
  fade?: number | string;
  justifyContent?: 'flex-start' | 'center' | 'flex-end' | 'space-between';
  phones?: string[];
  class?: string;
}

const {
  iconColor = '#ffffff',
  fade = '0.55',
  justifyContent = 'flex-start',
  phones = [phoneFormatted],
  class: className,
} = Astro.props;
---

<div
  class:list={['social-bar', className]}
  style={{
    '--icon-color': iconColor,
    '--fade': fade,
    '--justify': justifyContent,
  }}
>
  <!-- Socials -->
  <div class="social-group">
    <!-- Instagram -->
    <a href={socials.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="icon-link">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
      </svg>
    </a>

    <!-- WhatsApp -->
    <a href={whatsappLink} target="_blank" rel="noopener" aria-label="WhatsApp" class="icon-link">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </a>

    <!-- Facebook -->
    <a href={socials.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="icon-link">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.592 0 9 1.592 9 4.615V8z"/>
      </svg>
    </a>

    <!-- Email -->
    <a href={`mailto:${email}`} aria-label="Email" class="icon-link">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M0 3v18h24v-18h-24zm21.518 2l-9.518 7.713-9.518-7.713h19.036zm-19.518 14v-11.817l9.518 7.714 9.518-7.714v11.817h-19.036z"/>
      </svg>
    </a>
  </div>

  <span class="divider" aria-hidden="true">|</span>

  <!-- Phone numbers -->
  <div class="phone-group">
    {phones.map((phone) => (
      <a href={`tel:${phone}`} class="phone-link">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
          <path d="M6.54 5c.06.89.21 1.76.45 2.59l-1.2 1.2c-.41-1.2-.67-2.47-.76-3.79zm9.86 12.02c.85.24 1.72.39 2.6.45v1.49c-1.32-.09-2.59-.35-3.8-.75zM7.5 3H4c-.55 0-1 .45-1 1c0 9.39 7.61 17 17 17c.55 0 1-.45 1-1v-3.49c0-.55-.45-1-1-1c-1.24 0-2.45-.2-3.57-.57a.8.8 0 0 0-.31-.05c-.26 0-.51.1-.71.29l-2.2 2.2a15.15 15.15 0 0 1-6.59-6.59l2.2-2.2c.28-.28.36-.67.25-1.02A11.4 11.4 0 0 1 8.5 4c0-.55-.45-1-1-1"/>
        </svg>
        <span>{phone}</span>
      </a>
    ))}
  </div>
</div>

<style lang="less">
  .social-bar {
    width: 100%;
    height: auto;
    display: inline-flex;
    align-items: center;
    justify-content: var(--justify);
    gap: 0.875rem;
    color: var(--icon-color);
  }

  .social-group {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    opacity: var(--fade);
    transition: opacity 0.2s ease, transform 0.2s ease;

    &:hover {
      opacity: 1;
      transform: translateY(-1px);
    }
  }

  .divider {
    opacity: var(--fade);
    font-size: 0.85rem;
    line-height: 1;
    user-select: none;
  }

  .phone-group {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    opacity: var(--fade);
    transition: opacity 0.2s ease;

    &:hover {
      opacity: 1;
    }
  }
</style>