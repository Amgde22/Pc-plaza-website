---
import Socials from "./Socials.astro"
import {address} from "@data/client.json"
import heroImage from "@assets/images/hero.webp"
import { Icon } from 'astro-icon/components';
import { getLocalePath, t } from "i18n:astro";

const hero = t("hero" , { returnObjects: true })
const heroTitle = hero.title
const heroDescription = hero.description
const heroCta = hero.cta
const heroService1Title = hero.service1_title
const heroService2Title = hero.service2_title
const heroService3Title = hero.service3_title
const heroService4Title = hero.service4_title
const heroService1Description = hero.service1_description
const heroService2Description = hero.service2_description
const heroService3Description = hero.service3_description
const heroService4Description = hero.service4_description

const {mapLink} = address
---
<!-- ============================================ -->
<!--                    Hero                      -->
<!-- ============================================ -->

<section id="hero-1619">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">
                <svg class="cs-chevron" width="49" height="15" viewBox="0 0 49 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g opacity="0.7">
                    <path d="M0.621948 7.49889L6.40262 15L10.343 15L4.56231 7.49889L10.343 -4.2492e-07L6.40262 -2.52681e-07L0.621948 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M7.62195 7.49889L13.4026 15L17.343 15L11.5623 7.49889L17.343 -4.2492e-07L13.4026 -2.52681e-07L7.62195 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M14.7789 7.49889L20.5596 15L24.5 15L18.7193 7.49889L24.5 -4.2492e-07L20.5596 -2.52681e-07L14.7789 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M22.7789 7.49889L28.5596 15L32.5 15L26.7193 7.49889L32.5 -4.2492e-07L28.5596 -2.52681e-07L22.7789 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M30.7789 7.49889L36.5596 15L40.5 15L34.7193 7.49889L40.5 -4.2492e-07L36.5596 -2.52681e-07L30.7789 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M38.7789 7.49889L44.5596 15L48.5 15L42.7193 7.49889L48.5 -4.2492e-07L44.5596 -2.52681e-07L38.7789 7.49889Z" fill="var(--chevronColor)"/>
                    </g>
                </svg>
                {heroTitle}
                <svg class="cs-chevron" width="49" height="15" viewBox="0 0 49 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g opacity="0.7">
                    <path d="M48.3781 7.49889L42.5974 15L38.657 15L44.4377 7.49889L38.657 -4.2492e-07L42.5974 -2.52681e-07L48.3781 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M41.3781 7.49889L35.5974 15L31.657 15L37.4377 7.49889L31.657 -4.2492e-07L35.5974 -2.52681e-07L41.3781 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M34.2211 7.49889L28.4404 15L24.5 15L30.2807 7.49889L24.5 -4.2492e-07L28.4404 -2.52681e-07L34.2211 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M26.2211 7.49889L20.4404 15L16.5 15L22.2807 7.49889L16.5 -4.2492e-07L20.4404 -2.52681e-07L26.2211 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M18.2211 7.49889L12.4404 15L8.50004 15L14.2807 7.49889L8.50004 -4.2492e-07L12.4404 -2.52681e-07L18.2211 7.49889Z" fill="var(--chevronColor)"/>
                    <path d="M10.2211 7.49889L4.4404 15L0.500041 15L6.28071 7.49889L0.500042 -4.2492e-07L4.4404 -2.52681e-07L10.2211 7.49889Z" fill="var(--chevronColor)"/>
                    </g>
                </svg>
            </span>
            <h1 class="cs-title">
                {heroDescription}
            </h1>
            <div class="footer">
                <div class="cta-wrapper">
                    <a href={mapLink} target="_blank" class="cta cs-button-solid">
                        <Icon class={"flex-0"} name="mdi--location" size={25} />
                        {heroCta}
                    </a>
                </div>
                <Socials />
            </div>
        </div>

        <ul class="cs-card-group">
            <!-- Item 1 (Single-tone) -->
            <li class="cs-item">
                <svg class="cs-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 1024 1024">
                    <path d="M0 0h1024v1024H0z" fill="none" />
                    <path class="cs-icon-main" fill="#FF9E6B" d="M956.9 845.1L896.4 632V168c0-17.7-14.3-32-32-32h-704c-17.7 0-32 14.3-32 32v464L67.9 845.1C60.4 866 75.8 888 98 888h828.8c22.2 0 37.6-22 30.1-42.9M200.4 208h624v395h-624zm228.3 608l8.1-37h150.3l8.1 37zm224 0l-19.1-86.7c-.8-3.7-4.1-6.3-7.8-6.3H398.2c-3.8 0-7 2.6-7.8 6.3L371.3 816H151l42.3-149h638.2l42.3 149z" />
                </svg>
                <h3 class="cs-h3">{heroService1Title}</h3>
                <p class="cs-item-text">
                    {heroService1Description}
                </p>
            </li>

            <!-- Item 2 (Duotone) -->
            <li class="cs-item">
                <svg class="cs-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <g>
                        <path class="cs-icon-bg" fill="#FF9E6B" opacity=".45" d="M13.172 8c2.539 0 3.808 0 4.784.614q.372.233.684.542c.82.81 1.109 2.047 1.687 4.52l1.022 4.373A2.858 2.858 0 0 1 16 19.957l-.12-.246a3.2 3.2 0 0 0-2.876-1.794h-2.005A3.2 3.2 0 0 0 8.12 19.71l-.12.246a2.858 2.858 0 0 1-5.35-1.908l1.022-4.374c.578-2.472.867-3.708 1.687-4.519a4 4 0 0 1 .684-.542C7.02 8 8.289 8 10.828 8z" />
                        <path class="cs-icon-border" fill="#FD6301" d="M9.25 12a.75.75 0 0 0-1.5 0v.75H7a.75.75 0 0 0 0 1.5h.75V15a.75.75 0 0 0 1.5 0v-.75H10a.75.75 0 0 0 0-1.5h-.75zM15 13a1 1 0 1 0 0-2a1 1 0 0 0 0 2m3 1.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0M15.75 4a.75.75 0 0 0-1.5 0v1a.25.25 0 0 1-.25.25h-1A1.75 1.75 0 0 0 11.25 7v1h1.5V7a.25.25 0 0 1 .25-.25h1A1.75 1.75 0 0 0 15.75 5z" />
                    </g>
                </svg>
                <h3 class="cs-h3">{heroService2Title}</h3>
                <p class="cs-item-text">
                    {heroService2Description}
                </p>
            </li>

            <!-- Item 3 (Single-tone) -->
            <li class="cs-item">
                <svg class="cs-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 26 26">
                    <path d="M0 0h26v26H0z" fill="none" />
                    <path class="cs-icon-main" fill="#FF9E6B" d="M.719 0A1.004 1.004 0 0 0 1 2h3.469c.574 0 .757.115.906.25s.335.407.5.969l4.688 15.937a1 1 0 0 0 .03.094S11.704 22 14.5 22h7.844a1 1 0 1 0 0-2H14.5c-1.475 0-2.063-1.5-2.063-1.5l-.156-.5h8.125c1.03 0 1.496-.864 1.594-1.188l3.594-7.718C26.15 7.76 25.859 6 23.812 6h-14.5c-.166 0-.351.042-.53.094c-.36-1.223-.928-3.19-1-3.438c-.21-.713-.49-1.387-1.063-1.906S5.349 0 4.469 0H1a1 1 0 0 0-.094 0a1 1 0 0 0-.094 0A1 1 0 0 0 .72 0zm8.906 8.063h4.219v1.78h-3.656l-.47-1.5c-.032-.11-.08-.204-.093-.28m5.531 0h2.688v1.78h-2.688zm4 0h4.625a1 1 0 0 1-.062.218L23 9.844h-3.844zm-8.562 3.093h3.25v1.688h-2.719zm4.562 0h2.688v1.688h-2.688zm4 0h3.219l-.781 1.688h-2.438zm-7.625 3h2.313v1.781h-1.656c-.04 0-.062-.013-.094-.03l-.563-1.75zm3.625 0h2.688v1.781h-2.688v-1.78zm4 0H21l-.844 1.781h-1v-1.78zM14 22.187a1.812 1.812 0 1 0 0 3.625a1.812 1.812 0 0 0 0-3.625m6 0a1.812 1.812 0 1 0 0 3.625a1.812 1.812 0 0 0 0-3.625" />
                </svg>
                <h3 class="cs-h3">{heroService3Title}</h3>
                <p class="cs-item-text">
                    {heroService3Description}
                </p>
            </li>

            <!-- Item 4 (Duotone Badge) -->
            <li class="cs-item">
                <svg class="cs-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 80 80">
                    <path d="M0 0h80v80H0z" fill="none" />
                    <g>
                        <!-- Background fill layer (Primary-Light) -->
                        <path class="cs-icon-bg" fill="#FF9E6B" fill-opacity=".35" d="M49.094 18.047a9.67 9.67 0 0 1 12.86 12.86a9.67 9.67 0 0 1 0 18.187a9.67 9.67 0 0 1-12.86 12.86a9.67 9.67 0 0 1-18.187 0a9.67 9.67 0 0 1-18.187 0a9.67 9.67 0 0 1-12.86-12.86a9.67 9.67 0 0 1 0-18.187a9.67 9.67 0 0 1 12.86-12.86a9.67 9.67 0 0 1 18.187 0" />
                        <!-- Border / Checkmark stroke layer (Primary) -->
                        <path class="cs-icon-stroke" fill="none" stroke="#FD6301" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="m24.23 41.182l8.44 8.519a1.977 1.977 0 0 0 2.814 0L53.77 31.243m6.266-11.278a9.67 9.67 0 0 0-10.941-1.918a9.67 9.67 0 0 0-18.187 0a9.67 9.67 0 0 0-12.86 12.86a9.67 9.67 0 0 0 0 18.187a9.67 9.67 0 0 0 12.86 12.86a9.67 9.67 0 0 0 18.187 0a9.67 9.67 0 0 0 12.86-12.86a9.67 9.67 0 0 0 0-18.187a9.67 9.67 0 0 0-1.92-10.942" />
                    </g>
                </svg>
                <h3 class="cs-h3">{heroService4Title}</h3>
                <p class="cs-item-text">
                    {heroService4Description}
                </p>
            </li>
        </ul>
    </div>

    <!-- Background Image -->
    <picture class="cs-background" tabindex="-1">
        <source media="(max-width: 600px)" srcset={heroImage.src}>
        <source media="(min-width: 601px)" srcset={heroImage.src}>
        <img decoding="async" src={heroImage.src} alt="Cover picture" aria-hidden="true">
    </picture>
</section>

<style lang="less">

/*-- -------------------------- -->
<---           Hero             -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #hero-1619 {
        --heroGradient: linear-gradient(90deg, #111926 21.41%, rgba(17, 25, 38, 0.72) 34.98%, rgba(17, 25, 38, 0.00) 62.53%);
        
        padding: var(--sectionPadding);
        padding-top: clamp(12.5rem, 31.95vw, 18.75rem);
        position: relative;
        z-index: 1;
        width: 100vw;
        background: var(--dark);

        .cs-container {
            width: 100%;
            max-width: (1280/16rem);
            margin: auto;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            gap: clamp(3.75rem, 13vw, 11.25rem);
        }

        .cs-content {
            text-align: start;
            width: 100%;
            max-width: (780/16rem);
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .cs-topper {
            font-size: clamp(1rem, 2vw, 1.4rem);
            line-height: 1.2em;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-align: center;
            text-transform: uppercase;
            margin-bottom: (32/16rem);
            color: #FF9E6B;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: (8/16rem);
            position: relative;
        }

        .cs-chevron {
            --chevronColor: #FD6301;
            width: (48/16rem);
            height: auto;
            transition: transform 0.3s ease;
        }

        .cs-title {
            font-size: clamp(2rem, 6.40vw, 3.8125rem);
            font-weight: 700;
            line-height: 1.2em;
            text-align: start;
            max-width: 100%;
            margin: 0 0 (40/16rem) 0;
            color: #dedede;
            position: relative;
        }

        .footer {
            display: grid;
            grid-template-columns: 1fr;
            grid-template-rows: fit-content 1fr;
            gap: 25px;
            width: 100%;
        }

        .cs-text {
            font-size: clamp(1rem, 1.95vw, 1.25rem);
            line-height: 1.5em;
            text-align: inherit;
            width: 100%;
            max-width: clamp(29rem, 60vw, 38.785rem);
            margin: 0 0 (40/16rem) 0;
            color: #fff;
        }

        /* CTA Wrapper with Shimmer Animation */
        .cta-wrapper {
            position: relative;
            width: 100%;
            padding: 3px;
            border-radius: 4px;
            background: linear-gradient(
                90deg,
                #FD6301 0%,
                #FF9E6B 25%,
                #FFE3D1 45%,
                #FFFFFF 50%,
                #FFE3D1 55%,
                #FF9E6B 75%,
                #FD6301 100%
            );
            background-size: 200% 100%;
            animation: rgbBorder 4s linear infinite;
            box-shadow: 0 0 15px rgba(253, 99, 1, 0.35);
            
            @keyframes rgbBorder {
                0% {
                    background-position: 0% 0%;
                }
                100% {
                    background-position: 200% 0%;
                }
            }
        }

        .cs-button-solid {
            align-self: center;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: (16/16rem);
            line-height: clamp(2.875rem, 5.5vw, 3.5rem);
            text-decoration: none;
            font-weight: 700;
            margin: 0;
            color: #fff;
            letter-spacing: 2px;
            background-color: #121212;
            box-shadow: none;
            outline: none;
            position: relative;
            width: 100%;
            border-radius: 2px;

            svg {
                width: 20px;
                height: 20px;
                translate: 0 4px;
            }
            
            &:before {
                content: '';
                position: absolute;
                display: block;
                height: 100%;
                width: 0%;
                background: #000;
                opacity: 1;
                top: 0;
                left: 0;
                z-index: -1;
                transition: width .3s;
                border-radius: 2px;
            }

            &:hover {
                box-shadow: none;
                &:before {
                    width: 100%;
                }
            }
        }

        .cs-card-group {
            margin: 0;
            padding: 0;
            width: 100%;
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: clamp(1rem, 2.3vw, 1.25rem);
        }

        .cs-item {
            border-radius: 15px;
            width: 100%;
            text-align: left;
            list-style: none;
            margin: 0;
            padding: clamp(1.5rem, 3vw, 2rem);
            background-color: #eee;
            box-shadow: 0px 12px 80px 0px rgba(26, 26, 26, 0.18);
            box-sizing: border-box;
            grid-column: span 12;
            grid-row: span 1;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: center;
            position: relative;
            z-index: 1;
            translate: 0 -16px;
        }

        /* STRICT 48px ICON STYLES (Light Mode Default) */
        .cs-icon {
            width: 48px !important;
            height: 48px !important;
            min-width: 48px !important;
            min-height: 48px !important;
            max-width: 48px !important;
            max-height: 48px !important;
            margin: 0 0 (16/16rem) 0;
            flex: 0 0 48px !important;
            display: block;
            /* Neutralize global CodeStitch white-bleach filters */
            filter: none !important;

            /* Light mode: Single-tone uses primary-light */
            .cs-icon-main {
                fill: #FF9E6B !important;
                transition: fill 0.3s ease;
            }

            /* Duotone: border uses primary */
            .cs-icon-border {
                fill: #FD6301 !important;
                transition: fill 0.3s ease;
            }

            /* Duotone: stroke uses primary */
            .cs-icon-stroke {
                stroke: #FD6301 !important;
                fill: none !important;
                stroke-width: 3px !important;
                transition: stroke 0.3s ease;
            }


        }

        .cs-h3 {
            font-size: clamp(1.25rem, 2.5vw, 1.5625rem);
            line-height: 1.2em;
            font-weight: bold;
            text-align: inherit;
            margin: 0 0 (4/16rem) 0;
            color: var(--headerColor);
        }

        .cs-item-text {
            font-size: clamp(.875rem, 1.5vw, 1rem);
            line-height: 1.5em;
            max-width: (450/16rem);
            margin: 0;
            padding: 0;
            color: var(--bodyTextColor);
            margin-top: auto;
        }

        .cs-background {
            width: 100%;
            height: 55%;
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: -2;
            opacity: .7;

            &:before {
                content: '';
                width: 100%;
                height: 100%;
                background: #111926;
                opacity: .8;
                position: absolute;
                display: block;
                top: 0;
                left: 0;
                z-index: 1;
                pointer-events: none;
                user-drag: none;   
                -webkit-user-drag: none;   
            }
            
            img {
                position: absolute;
                top: 0;
                left: 0;
                height: 100%;
                width: 100%;
                object-fit: cover;
                object-position: top;
                pointer-events: none;
                user-drag: none;   
                -webkit-user-drag: none;   
                user-select: none;
                -webkit-user-select: none;
                -moz-user-select: none;
                -ms-user-select: none;
                -webkit-touch-callout: none;
                -webkit-tap-highlight-color: transparent;
            }
        }
    }
}

/* Tablet - 768px */
@media only screen and (min-width: 48rem) {
    #hero-1619 {
        padding-bottom: 0;
        .cs-container {
            align-items: flex-start;
        }
        .cs-item-text, .cs-h3 {
            text-align: start;
        }

        .cs-content {
            text-align: start;
            margin-left: 0;
            align-items: flex-start;
        }

        .cs-item {
            grid-column: span 3;
        }
        
        .cta-wrapper {
            max-width: 250px;
        }

        .cs-background {
            height: 87%;
            &:before {
                background: var(--heroGradient);
                opacity: 1;
            }
        }
    }
}

/* Large Desktop - 1300px */
@media only screen and (min-width: 81.25rem) {
    #hero-1619 {
        .cs-item {
            grid-column: span 3;
        }
    }
}
                                
/* Large Desktop Parallax Effect - 1600px */
@media only screen and (min-width: 100rem) {
    #hero-1619 {
        .cs-background {
            background: url("/src/assets/images/hero.webp");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            img {
                display: none;
            }
        }
    }
}

/* Dark Mode */
@media only screen and (min-width: 0rem) {
    :global(body.dark-mode) #hero-1619,
    body.dark-mode #hero-1619 {
        .cs-item {
            background-color: var(--medium);
        }

        .cs-h3, .cs-item-text {
            color: var(--bodyTextColorWhite);
        }
        .cs-button-solid {
            background-color: #121212;
        }

        /* Dark Mode Icon Overrides */
        .cs-icon {
            filter: none !important;

            /* Dark mode: Single-tone turns to primary */
            .cs-icon-main {
                fill: #FD6301 !important;
            }

            /* Duotone: border stays primary */
            .cs-icon-border {
                fill: #FD6301 !important;
            }
            .cs-icon-stroke {
                stroke: #FD6301 !important;
            }

            /* Duotone: background stays primary-light */
            .cs-icon-bg {
                // fill: #FF9E6B !important;
            }
        }

        .cs-text {
            opacity: .8;
        }

        .cs-background {
            background-color: #000;

            img {
                opacity: .5;
            }
            
            &:before {
                opacity: .9;
            }
        }
    }
}

/* RTL Logic */
:global([dir="rtl"]) {
    #hero-1619 {
        --heroGradient: linear-gradient(-90deg, #111926 21.41%, rgba(17, 25, 38, 0.72) 34.98%, rgba(17, 25, 38, 0.00) 62.53%);
    }
    
    #hero-1619 .cs-chevron {
        transform: rotate(180deg);
    }
}
</style>